{
 "tasks": [
  {
   "taskKey": "mental-rotation@configs/task.yaml",
   "timeline": {
    "caption": "One trial. The pair stays up until the answer, which stops the reaction-time clock.",
    "phases": [
     {
      "id": "iti",
      "label": "Empty apertures",
      "timing": {
       "kind": "parameter",
       "param": "intertrial_interval"
      },
      "start_events": [
       "ITI_ON"
      ]
     },
     {
      "id": "warning",
      "label": "Warning dot",
      "timing": {
       "kind": "parameter",
       "param": "warning_duration"
      },
      "start_events": [
       "WARNING_ON"
      ]
     },
     {
      "id": "pair",
      "label": "Pair",
      "timing": {
       "kind": "event",
       "until": "J (same) or F (different)",
       "max": {
        "param": "response_timeout"
       }
      },
      "start_events": [
       "PAIR_ON"
      ],
      "end_events": [
       "RESPONSE"
      ]
     }
    ],
    "tracks": [
     {
      "label": "Black surface, two apertures",
      "role": "stimulus",
      "from": "iti",
      "to": "pair"
     },
     {
      "label": "Dot",
      "role": "stimulus",
      "from": "warning",
      "to": "warning"
     },
     {
      "label": "Two drawings",
      "role": "stimulus",
      "from": "pair",
      "to": "pair"
     },
     {
      "label": "Same/different key",
      "role": "response",
      "from": "pair",
      "to": "pair"
     }
    ],
    "branches": [
     {
      "from": "pair",
      "kind": "failure",
      "when": "no key before the deadline",
      "outcome": "NO_RESPONSE",
      "effect": "served again at the end of the block"
     }
    ],
    "end": {
     "outcome": "CORRECT",
     "label": "CORRECT or WRONG"
    }
   },

{
 "tasks": [
  {
   "taskKey": "partial-report@configs/task.yaml",
   "timeline": {
    "caption": "One partial-report trial (Experiment 4, configs/task.yaml). The cue delay is set per block; the observer starts the trial and paces the report.",
    "phases": [
     {
      "id": "ready",
      "label": "Ready",
      "timing": {
       "kind": "event",
       "until": "SPACE",
       "max": {
        "ms": 60000
       }
      },
      "start_events": [
       "FIX_ON"
      ]
     },
     {
      "id": "start",
      "label": "Start delay",
      "timing": {
       "kind": "parameter",
       "param": "start_delay"
      }
     },
     {
      "id": "card",
      "label": "Card",
      "timing": {
       "kind": "parameter",
       "param": "exposure"
      },
      "start_events": [
       "ARRAY_ON"
      ],
      "end_events": [
       "ARRAY_OFF"
      ]
     },
     {
      "id": "wait",
      "label": "Cue delay",
      "timing": {
       "kind": "event",
       "until": "block's cue delay"
      },
      "note": "cue_delays_s from the card offset (−0.10 to 1.0 s); at −0.10 s the cue starts 50 ms before the card"
     },
     {
      "id": "cue",
      "label": "Row cue",
      "timing": {
       "kind": "parameter",
       "param": "cue_duration"
      },
      "start_events": [
       "REPORT_ON"
      ],
      "note": "CUE_HIGH, CUE_MID or CUE_LOW marks its onset; typing counts from REPORT_ON, one frame later"
     },
     {
      "id": "report",
      "label": "Typed report",
      "timing": {
       "kind": "event",
       "until": "Enter, all boxes filled",
       "max": {
        "param": "report_timeout"
       }
      },
      "start_events": [
       "RESPONSE_BOXES_ON"
      ],
      "end_events": [
       "RESPONSE"
      ]
     }
    ],
    "tracks": [
     {
      "label": "Dim cross",
      "role": "stimulus",
      "from": "ready",
      "to": "start"
     },
     {
      "label": "Lit card",
      "role": "stimulus",
      "from": "card",
      "to": "card"
     },
     {
      "label": "Dim cross",
      "role": "stimulus",
      "from": "wait",
      "to": "report"
     },
     {
      "label": "Bar by cued row",
      "role": "stimulus",
      "from": "cue",
      "to": "cue"
     },
     {
      "label": "Typed row",
      "role": "response",
      "from": "cue",
      "to": "report"
     }
    ],
    "branches": [
     {
      "from": "ready",
      "kind": "failure",
      "when": "no SPACE in time",
      "outcome": "NO_START"
     },
     {
      "from": "report",
      "kind": "failure",
      "when": "not committed in time",
      "outcome": "NO_RESPONSE"
     }
    ],
    "end": {
     "outcome": "REPORTED",
     "label": "REPORTED, scored per position"
    }
   },

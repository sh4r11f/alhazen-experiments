      "outcome": "TIMEOUT",
      "effect": "served again"
     }
    ],
    "end": {
     "outcome": "SET",
     "label": "SET: the test luminance is recorded"
    },
    "between_trials": {
     "label": "Dark interval",
     "timing": {
      "kind": "parameter",
      "param": "iti"
     }
    }

{
  "tasks": [
    {
      "taskKey": "oculomotor-delayed-response@configs/task.yaml",
      "timeline": {
        "caption": "One memory trial. The delay is one of three per trial; fixation must be held from acquisition until the spot goes off.",
        "phases": [
          {
            "id": "acquire",
            "label": "Acquire fixation",
            "timing": {
              "kind": "event",
              "until": "gaze in fixation window",
              "max": {
                "param": "acquire_timeout"
              }
            },
            "start_events": [
              "FIX_ON"
            ],
            "end_events": [
              "FIX_ACQUIRED"
            ]
          },
          {
            "id": "hold",
            "label": "Fixation",
            "timing": {
              "kind": "parameter",
              "param": "fixation_period"
            }
          },
          {
            "id": "cue",
            "label": "Cue",
            "timing": {
              "kind": "parameter",
              "param": "cue_duration"
            },
            "start_events": [
              "CUE_ON"
            ]
          },
          {
            "id": "delay",
            "label": "Delay",
            "timing": {
              "kind": "event",
              "until": "trial's delay (1.5, 3 or 6 s)",
              "max": {
                "ms": 6000
              }
            },
            "start_events": [
              "CUE_OFF"
            ]
          },
          {
            "id": "saccade",
            "label": "Go: saccade",
            "timing": {
              "kind": "event",
              "until": "gaze leaves fixation",
              "max": {
                "param": "response_period"
              }
            },
            "start_events": [
              "FIX_OFF"
            ],
            "end_events": [
              "SACCADE_ONSET"
            ]
          },
          {
            "id": "landing",
            "label": "Landing",
            "timing": {
              "kind": "event",
              "until": "gaze settles",
              "max": {
                "param": "landing_max_wait"
              }
            },
            "end_events": [
              "LANDED"
            ]
          }
        ],
        "tracks": [
          {
            "label": "Fixation spot",
            "role": "stimulus",
            "from": "acquire",
            "to": "delay"
          },
          {
            "label": "Cue square",
            "role": "stimulus",
            "from": "cue",
            "to": "cue"
          },
          {
            "label": "Hold gaze in window",
            "role": "requirement",
            "from": "hold",
            "to": "delay"
          },
          {
            "label": "Saccade to cued place",
            "role": "response",
            "from": "saccade",
            "to": "landing"
          }
        ],
        "branches": [
          {
            "from": "acquire",
            "kind": "failure",
            "when": "no fixation in time",
            "outcome": "NO_FIXATION",
            "effect": "served again later in the block"
          },
          {
            "from": "hold",
            "kind": "failure",
            "when": "gaze leaves the window",
            "outcome": "FIX_BREAK",
            "effect": "served again later in the block"
          },
          {
            "from": "cue",
            "kind": "failure",
            "when": "gaze leaves the window",
            "outcome": "FIX_BREAK",
            "effect": "served again later in the block"
          },
          {
            "from": "delay",
            "kind": "failure",
            "when": "gaze leaves the window",
            "outcome": "FIX_BREAK",
            "effect": "served again later in the block"
          },
          {
            "from": "saccade",
            "kind": "failure",
            "when": "no saccade in time",
            "outcome": "NO_SACCADE",
            "effect": "served again later in the block"
          }
        ],
        "end": {
          "outcome": "CORRECT",
          "label": "CORRECT, or INACCURATE if it lands outside the window"
        },
        "between_trials": {
          "label": "Inter-trial interval",
          "timing": {
            "kind": "parameter",
            "param": "iti"
          }
        }
      },

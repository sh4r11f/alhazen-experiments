            "timing": {
              "kind": "parameter",
              "param": "baseline_hold"
            }
          },
          {
            "id": "bars",
            "label": "Bars on",
            "timing": {
              "kind": "event",
              "until": "trigger time, 200-500 ms, drawn per trial"
            },
            "start_events": [
              "VIS_ON"
            ]
          },
          {
            "id": "after",
            "label": "Train or mark",
            "timing": {
              "kind": "event",
              "until": "bars end, 1.5-2 s after onset"
            },
            "start_events": [
              "STIM_TRIGGER",
              "CONTROL_MARK"
            ],
            "end_events": [
              "VIS_OFF"
            ]
          }
        ],
        "tracks": [
          {
            "label": "Fixation spot",
            "role": "stimulus",
            "from": "acquire",
            "to": "after"
          },
          {
            "label": "Oriented bar(s): RF, distracter or both",
            "role": "stimulus",
            "from": "bars",
            "to": "after"
          },
          {
            "label": "Gaze in fixation window",
            "role": "requirement",
            "from": "baseline",
            "to": "after"
          },
          {
            "label": "FEF train (stimulation trials only)",
            "role": "annotation",
            "from": "after",
            "to": "after"
          }
        ],
        "branches": [
          {
            "from": "acquire",
            "kind": "failure",
            "when": "no fixation in time",
            "outcome": "NO_FIXATION",
            "effect": "served again"
          },
          {
            "from": "baseline",
            "kind": "failure",
            "when": "gaze leaves the window",
            "outcome": "BROKE_FIX_BASELINE",
            "effect": "served again"
          },
          {
            "from": "bars",
            "kind": "failure",
            "when": "gaze leaves the window",
            "outcome": "BROKE_FIX_STIMULUS",
            "effect": "served again"
          },
          {
            "from": "after",
            "kind": "failure",
            "when": "gaze leaves the window",
            "outcome": "BROKE_FIX_AFTER_TRIGGER",
            "effect": "served again"
          }
        ],
        "end": {
          "outcome": "COMPLETED",
          "label": "COMPLETED (juice)"
        },
        "between_trials": {
